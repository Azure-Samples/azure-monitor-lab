{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.37.4.10188",
      "templateHash": "17259641343265824163"
    }
  },
  "parameters": {
    "capacityName": {
      "type": "string",
      "metadata": {
        "description": "Existing lab Fabric capacity name. The identity can act only on this capacity."
      }
    },
    "location": {
      "type": "string"
    },
    "hourUtc": {
      "type": "int",
      "minValue": 0,
      "maxValue": 23
    },
    "minuteUtc": {
      "type": "int",
      "minValue": 0,
      "maxValue": 59
    },
    "firstRunUtc": {
      "type": "string",
      "metadata": {
        "description": "First scheduled run, strictly in the future, in UTC ISO 8601 format."
      }
    }
  },
  "variables": {
    "capacityUrl": "[uri(environment().resourceManager, resourceId('Microsoft.Fabric/capacities', parameters('capacityName')))]",
    "roleName": "[guid(resourceGroup().id, resourceId('Microsoft.Fabric/capacities', parameters('capacityName')), 'fabric-auto-suspend-role')]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[format('{0}-auto-suspend', parameters('capacityName'))]",
      "location": "[parameters('location')]",
      "tags": {
        "purpose": "Azure Monitor Lab opt-in daily Fabric suspension"
      },
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Enabled",
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {},
          "triggers": {
            "Daily_UTC": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Day",
                "interval": 1,
                "startTime": "[parameters('firstRunUtc')]",
                "timeZone": "UTC",
                "schedule": {
                  "hours": [
                    "[parameters('hourUtc')]"
                  ],
                  "minutes": [
                    "[parameters('minuteUtc')]"
                  ]
                }
              }
            }
          },
          "actions": {
            "Read_capacity": {
              "type": "Http",
              "inputs": {
                "method": "GET",
                "uri": "[format('{0}?api-version=2023-11-01', variables('capacityUrl'))]",
                "authentication": {
                  "type": "ManagedServiceIdentity",
                  "audience": "[environment().resourceManager]"
                }
              },
              "runAfter": {}
            },
            "Suspend_if_active": {
              "type": "If",
              "expression": {
                "equals": [
                  "@body('Read_capacity')?['properties']?['state']",
                  "Active"
                ]
              },
              "actions": {
                "Suspend": {
                  "type": "Http",
                  "inputs": {
                    "method": "POST",
                    "uri": "[format('{0}/suspend?api-version=2023-11-01', variables('capacityUrl'))]",
                    "authentication": {
                      "type": "ManagedServiceIdentity",
                      "audience": "[environment().resourceManager]"
                    }
                  }
                },
                "Await_suspension": {
                  "type": "Until",
                  "operationOptions": "FailWhenLimitsReached",
                  "expression": "@or(equals(body('Read_suspended_capacity')?['properties']?['state'], 'Suspended'), equals(body('Read_suspended_capacity')?['properties']?['state'], 'Paused'))",
                  "limit": {
                    "count": 60,
                    "timeout": "PT10M"
                  },
                  "actions": {
                    "Wait_for_state": {
                      "type": "Wait",
                      "inputs": {
                        "interval": {
                          "count": 10,
                          "unit": "Second"
                        }
                      }
                    },
                    "Read_suspended_capacity": {
                      "type": "Http",
                      "inputs": {
                        "method": "GET",
                        "uri": "[format('{0}?api-version=2023-11-01', variables('capacityUrl'))]",
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "[environment().resourceManager]"
                        }
                      },
                      "runAfter": {
                        "Wait_for_state": [
                          "Succeeded"
                        ]
                      }
                    }
                  },
                  "runAfter": {
                    "Suspend": [
                      "Succeeded"
                    ]
                  }
                }
              },
              "else": {
                "actions": {
                  "Capacity_not_active": {
                    "type": "Compose",
                    "inputs": "@concat('Capacity was not suspended because its state is: ', body('Read_capacity')?['properties']?['state'])"
                  }
                }
              },
              "runAfter": {
                "Read_capacity": [
                  "Succeeded"
                ]
              }
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Authorization/roleDefinitions",
      "apiVersion": "2022-04-01",
      "name": "[variables('roleName')]",
      "properties": {
        "roleName": "[format('Azure Monitor Lab Fabric Suspend {0}', take(uniqueString(resourceId('Microsoft.Fabric/capacities', parameters('capacityName'))), 8))]",
        "description": "Read and suspend the single lab Fabric capacity. No resume, write, or data permissions.",
        "type": "CustomRole",
        "permissions": [
          {
            "actions": [
              "Microsoft.Fabric/capacities/read",
              "Microsoft.Fabric/capacities/suspend/action"
            ],
            "notActions": [],
            "dataActions": [],
            "notDataActions": []
          }
        ],
        "assignableScopes": [
          "[resourceGroup().id]"
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "scope": "[format('Microsoft.Fabric/capacities/{0}', parameters('capacityName'))]",
      "name": "[guid(resourceId('Microsoft.Fabric/capacities', parameters('capacityName')), resourceId('Microsoft.Logic/workflows', format('{0}-auto-suspend', parameters('capacityName'))), resourceId('Microsoft.Authorization/roleDefinitions', variables('roleName')))]",
      "properties": {
        "roleDefinitionId": "[resourceId('Microsoft.Authorization/roleDefinitions', variables('roleName'))]",
        "principalId": "[reference(resourceId('Microsoft.Logic/workflows', format('{0}-auto-suspend', parameters('capacityName'))), '2019-05-01', 'full').identity.principalId]",
        "principalType": "ServicePrincipal"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Authorization/roleDefinitions', variables('roleName'))]",
        "[resourceId('Microsoft.Logic/workflows', format('{0}-auto-suspend', parameters('capacityName')))]"
      ]
    }
  ]
}