// CHART — Token usage by agent (bar)
// -------------------------------------------------------------------
// Purpose:  Visual chargeback input. One bar per agent shows measured tokens.
// Render:   Portal Logs / Workbook only (CLI ignores render).
// Pricing:  Apply actual per-model rates outside this query.

dependencies
| where timestamp > ago(1d)
      and isnotempty(tostring(customDimensions["gen_ai.agent.name"]))
| extend inTok  = toint(customDimensions["gen_ai.usage.input_tokens"]),
         outTok = toint(customDimensions["gen_ai.usage.output_tokens"]),
         agent  = tostring(customDimensions["gen_ai.agent.name"])
| summarize total_tokens=sum(inTok)+sum(outTok) by agent
| order by total_tokens desc
| render barchart with (title="Measured tokens by agent", xtitle="tokens")
