// Tokens per successful request, by agent (last 24h)
// -------------------------------------------------------------------
// Purpose:  Efficiency metric joining usage and reliability. Failed/retried
//           calls still burn tokens, so this divides measured tokens by the
//           number of successful requests.
// Source:   Application Insights `dependencies` (GenAI spans). Uses the
//           native `success` column for pass/fail.
// Pricing:  Apply the actual model-specific rates separately.

dependencies
| where timestamp > ago(1d)
      and isnotempty(tostring(customDimensions["gen_ai.agent.name"]))
| extend inTok  = toint(customDimensions["gen_ai.usage.input_tokens"]),
         outTok = toint(customDimensions["gen_ai.usage.output_tokens"]),
         agent  = tostring(customDimensions["gen_ai.agent.name"])
| summarize prompt=sum(inTok), completion=sum(outTok),
            total=count(), ok=countif(success == true) by agent
| extend success_rate=round(100.0 * ok / total, 1),
         tokens_per_success=round(iff(ok > 0, todouble(prompt+completion) / ok, real(null)), 1)
| project agent, total, ok, success_rate, prompt, completion, tokens_per_success
| order by tokens_per_success desc
